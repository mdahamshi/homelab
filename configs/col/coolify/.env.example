# Coolify control-plane environment (placeholders only — copy to .env)
# Generate each value with a strong random source and keep it secret.

APP_NAME=Coolify
APP_ENV=production
# base64-encoded 32-byte app key: `base64 /dev/urandom | head -c32 | base64`
APP_KEY=base64:CHANGE_ME_32_BYTE_KEY

DB_USERNAME=coolify
DB_DATABASE=coolify
DB_HOST=coolify-db
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_HOST=coolify-redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

PUSHER_APP_ID=CHANGE_ME
PUSHER_APP_KEY=CHANGE_ME
PUSHER_APP_SECRET=CHANGE_ME

REGISTRY_URL=docker.io
DOCKER_ADDRESS_POOL_BASE=10.0.0.0/8
DOCKER_ADDRESS_POOL_SIZE=24
