# Authentik — environment (placeholders only — copy to .env)
SERVICE_NAME_AUTHENTIK_SERVER=authentik-server
SERVICE_NAME_AUTHENTIK_WORKER=authentik-worker
SERVICE_NAME_POSTGRESQL=postgresql
SERVICE_NAME_REDIS=redis
# Shared across server + worker + postgresql
SERVICE_USER_POSTGRESQL=CHANGE_ME_DB_USER
SERVICE_PASSWORD_POSTGRESQL=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=authentik
POSTGRESQL_DATABASE=authentik
# base64-encoded secret key used by both server and worker
SERVICE_PASSWORD_64_AUTHENTIKSERVER=CHANGE_ME_64_BYTE_BASE64
AUTHENTIK_SECRET_KEY=CHANGE_ME_64_BYTE_BASE64
# Outbound email (optional — leave empty to disable)
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=authentik@example.home
# URLs
SERVICE_FQDN_AUTHENTIK=auth.example.com
SERVICE_URL_AUTHENTIK=http://auth.example.com
