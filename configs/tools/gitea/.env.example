# Gitea — environment (placeholders only — copy to .env)
SERVICE_NAME_GITEA=gitea
SERVICE_NAME_POSTGRESQL=postgresql
USER_UID=1000
USER_GID=1000
SERVICE_USER_POSTGRESQL=CHANGE_ME_DB_USER
SERVICE_PASSWORD_POSTGRESQL=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gitea
POSTGRESQL_DATABASE=gitea
GITEA__database__USER=CHANGE_ME_DB_USER
GITEA__database__PASSWD=CHANGE_ME_STRONG_PASSWORD
SERVICE_FQDN_GITEA=git.example.home
SERVICE_URL_GITEA=http://git.example.home
SERVICE_FQDN_GITEA_3000=git.example.home:3000
SERVICE_URL_GITEA_3000=http://git.example.home:3000
