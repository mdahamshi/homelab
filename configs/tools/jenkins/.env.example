# Jenkins — environment (placeholders only — copy to .env)
SERVICE_NAME_JENKINS=jenkins
JENKINS_HOME=/var/jenkins_home
JENKINS_SLAVE_AGENT_PORT=50000
JAVA_OPTS=-Djenkins.install.runSetupWizard=false
