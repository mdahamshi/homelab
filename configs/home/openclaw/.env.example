# OpenClaw — environment (placeholders only — copy to .env)
# Leave provider keys empty to disable that provider. AUTH_USERNAME/AUTH_PASSWORD
# protect the agent UI behind basic auth; the gateway token is used for
# integrations.
SERVICE_NAME_OPENCLAW=openclaw
SERVICE_NAME_BROWSER=browser
PUID=1000
PGID=1000
TZ=Etc/UTC
AUTH_USERNAME=CHANGE_ME
AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SERVICE_PASSWORD_OPENCLAW=CHANGE_ME_STRONG_PASSWORD
SERVICE_PASSWORD_64_GATEWAYTOKEN=CHANGE_ME_64_BYTE_BASE64
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
# LLM providers
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
MISTRAL_API_KEY=CHANGE_ME
XAI_API_KEY=CHANGE_ME
# Messaging bots
TELEGRAM_BOT_TOKEN=CHANGE_ME
DISCORD_BOT_TOKEN=CHANGE_ME
SLACK_BOT_TOKEN=CHANGE_ME
SLACK_APP_TOKEN=CHANGE_ME
# URLs
SERVICE_FQDN_OPENCLAW=claw.example.home
SERVICE_URL_OPENCLAW=https://claw.example.home
SERVICE_FQDN_OPENCLAW_8080=claw.example.home:8080
SERVICE_URL_OPENCLAW_8080=https://claw.example.home:8080
