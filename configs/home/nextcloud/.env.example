# Nextcloud — environment (placeholders only — copy to .env)
SERVICE_NAME_NEXTCLOUD=nextcloud
SERVICE_NAME_NEXTCLOUD_DB=nextcloud-db
SERVICE_NAME_REDIS=redis
PUID=1000
PGID=1000
TZ=Europe/Paris
# DB credentials are shared by the nextcloud / nextcloud-db / redis services
SERVICE_USER_POSTGRES=CHANGE_ME_DB_USER
SERVICE_PASSWORD_POSTGRES=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_DB=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=nextcloud-db
REDIS_HOST=redis
REDIS_PORT=6379
SERVICE_FQDN_NEXTCLOUD=nextcloud.example.home
SERVICE_URL_NEXTCLOUD=http://nextcloud.example.home
SERVICE_FQDN_NEXTCLOUD_80=nextcloud.example.home:80
SERVICE_URL_NEXTCLOUD_80=http://nextcloud.example.home:80
